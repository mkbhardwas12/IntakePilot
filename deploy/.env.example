# Copy to deploy/.env and edit. Used by docker-compose.prod.yml.

# --- Required ---
POSTGRES_PASSWORD=change-me

# --- Strongly recommended beyond localhost ---
# One token closes every admin/ops surface (system-KB, glossary, evals
# replay, reroute): callers must send  Authorization: Bearer <token>
#INTAKEPILOT_ADMIN_TOKEN=
# Same secret as in your GitHub webhook settings -> X-Hub-Signature-256
# verification on /api/webhooks/github
#INTAKEPILOT_WEBHOOK_SECRET=

# --- Optional (defaults shown) ---
#POSTGRES_USER=intakepilot
#POSTGRES_DB=intakepilot
#WEB_PORT=80

# Local LLM is the out-of-box production path. Docker Compose reads
# COMPOSE_PROFILES from this file, so the ollama service starts with the
# ordinary `docker compose -f docker-compose.prod.yml up -d --build` command.
# For an external OpenAI-compatible endpoint, set COMPOSE_PROFILES= and
# INTAKEPILOT_LLM=openai_compat below.
COMPOSE_PROFILES=local-llm
INTAKEPILOT_LLM=ollama
OLLAMA_BASE_URL=http://ollama:11434

# Hybrid model strategy (optional): a stronger model used ONLY when the
# primary fails structured-output validation twice — e.g. local Ollama as
# primary + a cloud frontier or big internal model for the hard turns.
# Escalations become rare as the learning ledger grows from daily usage.
#INTAKEPILOT_LLM_ESCALATION=openai_compat

# External OpenAI-compatible endpoint (vLLM, LiteLLM, Azure OpenAI, internal
# gateway). Set INTAKEPILOT_LLM=openai_compat and:
#OPENAI_BASE_URL=http://your-llm-gateway:8001/v1
#OPENAI_MODEL=qwen3-32b
#OPENAI_API_KEY=

# Ticket target: local (default, writes to a repo folder) | github
#INTAKEPILOT_TARGET=github
#GITHUB_TOKEN=            # required for the github target (repo set in
                          # intakepilot.yaml targets.github.repo)

# Managed/external Postgres: remove the db service from the compose file and
# set the full DSN on the api service instead:
#DATABASE_URL=postgresql://user:pass@your-db-host:5432/intakepilot
