# Public demo host — copy to deploy/.env.demo and fill in.

DEMO_ORIGIN=https://demo.example.com
WEB_PORT=80

# REQUIRED for public demo — leave empty and compose will refuse to start.
INTAKEPILOT_ADMIN_TOKEN=replace-with-long-random
INTAKEPILOT_WEBHOOK_SECRET=replace-with-long-random
# Optional
#INTAKEPILOT_JIRA_WEBHOOK_SECRET=
